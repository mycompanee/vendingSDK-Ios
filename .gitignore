#
# Artifact-only repository:
# Keep ONLY the output of `build-xcframework.sh` (the contents of `build/`)
# in version control and ignore everything else.
#

# Ignore everything by default
*

# But keep gitignore itself
!.gitignore

# Keep the built artifacts
!/build/
!/build/**

# Keep selected metadata files
!/LICENSE
!/README.md
!/CHANGELOG.md

# Keep the sample/example app
!/VendingIosSDKSampleApp/
!/VendingIosSDKSampleApp/**


